{
  "name": "toolbelt",
  "version": "0.11.0",
  "private": true,
  "description": "A developer's toolbelt: fast, privacy-first browser tools — JSON formatter, JWT decoder, Base64, URL encoder, invoice generator, unicode inspector. By CODERCOPS.",
  "license": "MIT",
  "author": "CODERCOPS (https://www.codercops.com)",
  "homepage": "https://tools.codercops.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/codercops/toolbelt.git"
  },
  "bugs": {
    "url": "https://github.com/codercops/toolbelt/issues"
  },
  "keywords": [
    "developer-tools",
    "json-formatter",
    "jwt-decoder",
    "base64",
    "url-encoder",
    "invoice-generator",
    "timestamp-converter",
    "color-converter",
    "case-converter",
    "number-base-converter",
    "uuid-generator",
    "cron-explainer",
    "csv-formatter",
    "regex-tester",
    "markdown-preview",
    "unicode-inspector",
    "nextjs",
    "privacy",
    "client-side"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/og-assets.mjs",
    "prebuild": "node scripts/og-assets.mjs && node scripts/write-version.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "fonts": "node scripts/fetch-fonts.mjs",
    "lighthouse": "npx --yes @lhci/cli@0.14.x collect && (npx --yes @lhci/cli@0.14.x assert || true) && node scripts/lighthouse-summary.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@opennextjs/cloudflare": "^1.20.13",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "json5": "^2.2.3",
    "jsonpath-plus": "^10.4.0",
    "jspdf": "^4.2.1",
    "lossless-json": "^4.3.3",
    "lucide-react": "^0.468.0",
    "marked": "^18.1.1",
    "next": "^16.4.3",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^20",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "happy-dom": "^21.0.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "^10.5.0"
    },
    "undici@7": "^7.30.1",
    "postcss-selector-parser": "^7.1.6",
    "sharp": "^0.35.5"
  }
}

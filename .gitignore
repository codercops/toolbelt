# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.development
.env.production
!.env.example

# editor / local tooling
.idea
.vscode/*
!.vscode/extensions.json

# typescript
*.tsbuildinfo
next-env.d.ts

# generated PWA output (do not commit)
/public/sw.js
/public/workbox-*.js

# generated invoice output from manual testing
/invoice-*.pdf

# Cloudflare: OpenNext output, local wrangler state, local secrets, build stamp
.open-next/
.wrangler/
.dev.vars*
public/version.txt

# Generated by scripts/og-assets.mjs before build/dev.
generated/
